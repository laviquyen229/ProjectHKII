# Sao chép file này thành `.env` rồi chỉnh. KHÔNG commit `.env`.
POSTGRES_USER=hkii
POSTGRES_PASSWORD=doi_mat_khau_nay
POSTGRES_DB=hkii
DB_PORT=5433
API_PORT=8000

# Khóa ký JWT. Tạo ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me

# Tự tạo dữ liệu mẫu khi khởi động (chỉ chạy nếu DB còn trống). Tắt bằng false.
SEED_ON_START=true
SEED_PASSWORD=Hkii@12345

# Tùy chọn: bật AI Coach thật bằng Gemini. Bỏ trống thì dùng bộ nhận xét theo luật.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
