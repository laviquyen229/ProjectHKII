digraph G { rankdir=LR; graph[fontname="Times-Roman",fontsize=12,nodesep=0.6,ranksep=1.3,dpi=200]; node[fontname="Times-Roman",fontsize=12]; edge[fontname="Times-Roman",fontsize=10];
sys[label="0\nEduCenter\nManagement System",shape=circle,width=2.2,style=bold];
admin[label="Admin",shape=box,width=1.3]; teacher[label="Teacher",shape=box,width=1.3];
student[label="Student",shape=box,width=1.3]; parent[label="Parent",shape=box,width=1.3]; gem[label="Google Gemini API",shape=box];
admin->sys[label="User accounts, classes,\nenrolments, tuition records"]; sys->admin[label="Dashboards, tuition summary,\nExcel reports"];
teacher->sys[label="Attendance sheets,\nscores, writing texts"]; sys->teacher[label="Class rosters,\nclass reports (.xlsx)"];
student->sys[label="Credentials,\nwriting / speaking texts"]; sys->student[label="Attendance, grades,\ntuition, AI feedback"];
parent->sys[label="Credentials,\nselected child"]; sys->parent[label="Child attendance,\ngrades, tuition"];
sys->gem[label="Prompt + student text"]; gem->sys[label="Generated feedback"];
{rank=same; admin; teacher;} {rank=same; student; parent; gem;}
admin->sys[style=invis]; sys->student[style=invis];
}
